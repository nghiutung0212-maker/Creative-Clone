{
  "scene_id": "podcast",
  "scene_name": "播客选题",
  "scene_description": "音频/视频播客单集选题与话题设计，产出在时长内可聊透、有明确话题主线和讨论点、与节目定位一致的选题。",
  "questionnaire_template": {
    "rounds": [
      {
        "round_id": 1,
        "round_title": "定位、类型与听众",
        "questions": [
          {
            "field": "podcast_position",
            "question": "节目的定位或主题领域是什么？",
            "type": "text",
            "required": true
          },
          {
            "field": "show_type",
            "question": "节目类型是？",
            "type": "choice",
            "options": ["闲聊聊天", "知识科普", "观点评论", "故事讲述", "嘉宾访谈", "行业揭秘"],
            "required": true
          },
          {
            "field": "audience",
            "question": "目标听众是谁？",
            "type": "text",
            "required": true
          }
        ]
      },
      {
        "round_id": 2,
        "round_title": "时长、形式与阶段",
        "questions": [
          {
            "field": "duration",
            "question": "单集时长一般是？",
            "type": "choice",
            "options": ["15分钟以内", "15-40分钟", "40-60分钟", "60分钟以上"],
            "required": true
          },
          {
            "field": "format",
            "question": "节目形式？",
            "type": "choice",
            "options": ["单人", "双人对谈", "多人圆桌", "嘉宾访谈"],
            "required": true
          },
          {
            "field": "stage",
            "question": "节目目前处于什么阶段？",
            "type": "choice",
            "options": ["还没开播", "前 10 期", "成长期", "成熟节目"],
            "required": true
          }
        ]
      },
      {
        "round_id": 3,
        "round_title": "风格、目标与红线",
        "questions": [
          {
            "field": "style",
            "question": "希望什么节目风格？",
            "type": "choice",
            "options": ["轻松玩梗", "深度专业", "犀利锐评", "温柔陪伴"],
            "required": true
          },
          {
            "field": "goal",
            "question": "现阶段目标是？",
            "type": "choice",
            "options": ["兴趣表达", "涨粉", "打造个人 IP", "商业变现"],
            "required": true
          },
          {
            "field": "red_lines",
            "question": "有哪些不想聊、不能碰的话题？",
            "type": "text",
            "required": false
          }
        ]
      }
    ],
    "skip_logic": {
      "description": "根据形式、阶段、时长与风格调整选题。",
      "rules": [
        "用户选「单人」→ 不设计强互动环节，选题改为有起承转合的单人叙事线",
        "用户选「还没开播」→ 输出追加前 3 期节目规划，选题优先易制作、能立人设的方向",
        "用户选「15分钟以内」→ 只输出单一话题，不做多话题拼盘",
        "用户选「深度专业」风格 → 语气切换专业克制，每个选题给出资料准备清单",
        "用户选「嘉宾访谈」→ Step 3 追问嘉宾资源，选题须给出嘉宾专属问题"
      ]
    }
  },
  "tone_rules": {
    "base_tone": "轻松玩梗",
    "allow_humor": true,
    "allow_informal": true,
    "tone_examples": [
      "正确：今天聊一个我们自己也踩过的坑，先讲事情是怎么发生的，再说说为什么没人提前发现。",
      "正确：这个话题没有标准答案，我们先把几种说法摆出来，最后留一个问题给你。",
      "错误：本节目将围绕该议题展开系统性、框架性的论述。",
      "错误：某某就是个骗子，大家都该去骂他。（无证据指控、引战）"
    ],
    "conditional_notes": [
      "风格选「深度专业」时，语气切换专业克制，仍可口语化但论证要完整。",
      "观点可以鲜明，但不得无证据指控、造谣或触碰平台红线。"
    ]
  },
  "constraint_list": [
    "选题必须能在时长内聊透，话题边界清晰",
    "必须有明确的话题主线与分层讨论点",
    "表达口语化、有对话感，不能写成书面朗读稿",
    "选题与节目定位、人设一致",
    "必须给出开场钩子与结尾互动引导",
    "观点表达符合法律法规与平台规则"
  ],
  "exclusion_rules": [
    "没有讨论空间的常识性话题",
    "需要听众具备大量专业背景才能听懂的内容",
    "平台敏感、违规话题",
    "与节目定位无关的热点硬蹭",
    "纯念稿、无观点、无信息增量",
    "用户在 red_lines 中明确列出的话题"
  ],
  "output_format_adjustments": {
    "title_format": "EP.{期数}｜{话题标题}",
    "extra_fields": ["开场钩子", "分层讨论问题清单", "建议时长", "互动引导语", "资料准备清单"],
    "suppress_fields": []
  }
}
